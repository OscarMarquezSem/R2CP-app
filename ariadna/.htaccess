# ARIADNA · Seguridad básica para Hostinger (Apache/LiteSpeed)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Bloquear archivos internos
  RewriteRule ^(inc|install|cron|storage)(/|$) - [F,L]
  RewriteRule ^config(\.sample)?\.php$ - [F,L]
</IfModule>

<FilesMatch "\.(sql|log|md)$">
  Require all denied
</FilesMatch>
